# XR1710G (Gemtek) OpenWrt build configuration
# Target: airoha/an7581, device Gemtek XR1710G (UBI)

# --- Target / device ---
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_gemtek_xr1710g-ubi=y
CONFIG_TARGET_BOARD="airoha"
CONFIG_TARGET_SUBTARGET="an7581"
CONFIG_TARGET_PROFILE="DEVICE_gemtek_xr1710g-ubi"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"

# --- Image / filesystem ---
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_SQUASHFS_BLOCK_READERS=4
CONFIG_TARGET_SQUASHFS_SMALL_READERS=4
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y
CONFIG_TARGET_UBIFS_JOURNAL_SIZE=""
CONFIG_TARGET_ROOTFS_DIR=""
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53"
CONFIG_TARGET_SUFFIX="musl"

# --- Preinit ---
CONFIG_TARGET_PREINIT_SUPPRESS_STDERR=y
CONFIG_TARGET_PREINIT_TIMEOUT=4
CONFIG_TARGET_PREINIT_IFNAME=""
CONFIG_TARGET_PREINIT_IP="192.168.1.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.1.255"

# --- LuCI language: Simplified Chinese for all apps ---
CONFIG_LUCI_LANG_zh_Hans=y

# --- Extra LuCI applications ---
CONFIG_PACKAGE_luci-app-airoha-flowsense=y
CONFIG_PACKAGE_luci-app-netspeedtest=y
CONFIG_PACKAGE_luci-i18n-netspeedtest-zh-cn=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y

# --- Themes ---
CONFIG_PACKAGE_luci-theme-argon=y

# --- Standalone services ---
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_rtp2httpd=y

# --- Kernel modules (explicitly requested) ---
CONFIG_PACKAGE_kmod-leds-pwm=y
CONFIG_PACKAGE_kmod-pwm-airoha=y
